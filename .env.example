# Create a Google AI Studio API key and place it in .env (never commit .env).
# New authorization keys commonly start with AQ.; legacy standard keys start with AIza.
GEMINI_API_KEY=AQ.ReplaceWithNewGoogleAiStudioAuthorizationKey
# Keep this at 768 to match the pgvector column used by the RAG store.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional local overrides
DB_HOST=localhost
DB_NAME=ai_mock_interviews
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_PORT=5432

# ==========================================
# Web Research Pipeline (Tavily + Firecrawl + Gemini)
# Used by web_research/ and by question_pipeline's research provider.
# ==========================================
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
TAVILY_MAX_RESULTS=5
FIRECRAWL_MAX_PAGES=3
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
RESEARCH_TIMEOUT_SECONDS=60

# ==========================================
# Interview Question Generation Pipeline (question_pipeline/)
# See the root README for what each of these does.
# ==========================================
# MOCK_MODE=true routes every provider through a mock: no real calls, no spend.
# A real rollout batch refuses to start unless this is false.
MOCK_MODE=true

# Research stage
RESEARCH_PROVIDER=perplexity
RESEARCH_MODEL=sonar
PERPLEXITY_API_KEY=

# Generation + synthesis
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite

# Embeddings (must match the pgvector column dimension used by the RAG store)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2

# Validation ladder: primary -> fallback -> escalation
VALIDATION_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=openai
FALLBACK_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ESCALATION_PROVIDER=anthropic
ESCALATION_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_API_KEY=

# Rate limiting (15 RPM is the Gemini free-tier default)
GEMINI_RPM_LIMIT=15

# Thresholds
PIPELINE_BATCH_SIZE=4
SEMANTIC_SIMILARITY_THRESHOLD=0.86
NORMALIZED_OVERLAP_THRESHOLD=0.85
COMPANY_CONTEXT_MIN_SIMILARITY=0.35
VALIDATION_PASS_SCORE=0.70
