    {% for comp in core_competencies %}{
      "name": "{{ comp.name }}",
      "weight": {{ comp.weight }},
      "score": <float 0-5>,
      "highlights": ["<behavioural strength with evidence>"] ,
      "gaps": ["<behavioural gap with evidence>"] ,
      "next_steps": ["<coaching action>"] ,
      "evidence": ["<quotes or paraphrased moments supporting the rating>"]
    }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "communication_summary": {
    "score": <float 0-5>,
    "highlights": ["<communication strengths>"] ,
    "gaps": ["<communication gaps>"] ,
    "next_steps": ["<communication coaching>"]
  },
  "attitude_summary": {
    "score": <float 0-5>,
    "highlights": ["<mindset strengths>"] ,
    "gaps": ["<mindset gaps>"] ,
    "next_steps": ["<mindset coaching>"]
  }
